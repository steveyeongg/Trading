# Copy to .env and fill in real values for local dev.
# This file is the authoritative catalog of every env var the system reads —
# mirrors `docs/runbooks/OPERATIONS.md` "Going live (real-data) toggles".
# Uncomment the lines you actually use — every feature is fail-soft if absent.

# ────────────────────────────────────────────────────────────────────────────
# Runtime
# ────────────────────────────────────────────────────────────────────────────
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=false

# ────────────────────────────────────────────────────────────────────────────
# Data stores (matches infra/docker/docker-compose.yml)
# ────────────────────────────────────────────────────────────────────────────
POSTGRES_DSN=postgresql+asyncpg://atlas:atlas_dev@localhost:5432/atlas
REDIS_URL=redis://localhost:6379/0

# ────────────────────────────────────────────────────────────────────────────
# Auth — dev mode needs no secrets. Switch to "jwt" to wire Clerk/Auth0.
# ────────────────────────────────────────────────────────────────────────────
ATLAS_AUTH_MODE=dev
ATLAS_DEV_TIER=pro
# ATLAS_JWKS_URL=https://YOUR-TENANT.clerk.accounts.dev/.well-known/jwks.json
# ATLAS_JWT_ISSUER=https://YOUR-TENANT.clerk.accounts.dev
# ATLAS_JWT_AUDIENCE=atlas-api
# ATLAS_JWT_TIER_CLAIM=tier

# ────────────────────────────────────────────────────────────────────────────
# ML registry
# ────────────────────────────────────────────────────────────────────────────
# ATLAS_TREND_MODEL=ml/registry/trend/v1.joblib

# ────────────────────────────────────────────────────────────────────────────
# Signal gates (BLUEPRINT §9.4 defaults shown). Lower these in sparse-data
# environments — e.g. running bars-only without macro/news/options feeds.
# Weight renormalisation already handles deferred adapters; these knobs are
# for when you want even more signals firing during development.
# ────────────────────────────────────────────────────────────────────────────
# ATLAS_MIN_COMPOSITE=50.0
# ATLAS_MIN_CONFIDENCE=0.55
# ATLAS_MIN_CONFIRMING_ENGINES=2
# ATLAS_MIN_AGREE_THRESHOLD=40.0

# ────────────────────────────────────────────────────────────────────────────
# Market-data adapters — set Polygon OR Alpaca (or both).
# `backfill --source auto` picks Polygon first, falls back to Alpaca, and
# ERRORS OUT if neither is configured (no implicit synthetic fallback).
# For an offline / no-key dev path, use the explicit `synthetic` subcommand:
#   uv run python -m ingest_equities synthetic --symbols AAPL,MSFT --n-bars 1000
# CLI:  uv run python -m ingest_equities backfill --source polygon|alpaca|auto …
# ────────────────────────────────────────────────────────────────────────────
# POLYGON_API_KEY=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_DATA_URL=https://data.alpaca.markets         # data plane (bars/quotes/trades)
# ALPACA_BASE_URL=https://paper-api.alpaca.markets    # trading plane (orders), paper by default

# Macro + news adapters — leave commented to use the offline-friendly fallbacks
# FRED_API_KEY=
# NEWSAPI_KEY=

# ────────────────────────────────────────────────────────────────────────────
# LLM (Explanation engine) — DeepSeek (OpenAI-compatible).
# Without this, the templated fallback runs.
# Get a key at https://platform.deepseek.com → API Keys.
# ────────────────────────────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com          # override only if using a proxy
# ATLAS_EXPLAIN_MODEL=deepseek-chat                   # or deepseek-reasoner (R1)

# ────────────────────────────────────────────────────────────────────────────
# Alert channels — each is independent; channel reports unavailable if any
# of its required vars is missing. The "log" channel is always on.
# ────────────────────────────────────────────────────────────────────────────

# Webhook channel — POST signed with HMAC-SHA256 over the JSON body
# ATLAS_WEBHOOK_URL=https://hooks.example.com/atlas
# ATLAS_WEBHOOK_SECRET=replace-with-32+-random-bytes

# Telegram channel — both vars required.
# 1. Talk to @BotFather → /newbot → grab the token.
# 2. Add the bot to your chat/channel, send any message, then:
#      curl https://api.telegram.org/bot<TOKEN>/getUpdates
#    The chat id is at result[0].message.chat.id (negative for channels).
# TELEGRAM_BOT_TOKEN=123456789:ABCDEF-your-token-here
# TELEGRAM_CHAT_ID=987654321

# Email (SMTP) channel — all six required.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-specific-password
# ALERT_EMAIL_FROM=atlas@example.com
# ALERT_EMAIL_TO=you@example.com
